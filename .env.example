# Never commit a real token or password. Copy to .env locally and fill through a secret manager in production.
POSTGRES_DB=burmaldoza
POSTGRES_USER=burmaldoza
POSTGRES_PASSWORD=change-me-before-local-run
DATABASE_URL=postgresql+asyncpg://burmaldoza:change-me-before-local-run@localhost:5432/burmaldoza
REDIS_URL=redis://redis:6379/0
API_PORT=8000
MINIAPP_PORT=4173
BOT_TOKEN=replace-with-a-fresh-botfather-token
MINIAPP_URL=http://localhost:4173
API_BASE_URL=http://localhost:8000
ENVIRONMENT=development
